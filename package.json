{
  "name": "lookacrawler",
  "version": "1.1.2",
  "description": "Token-optimized local MCP server for web crawling and LLM content extraction",
  "main": "index.ts",
  "bin": {
    "lookacrawler": "./cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch run index.ts",
    "cli": "bun run cli.ts",
    "serve": "bun run index.ts --transport sse",
    "build": "bun build index.ts --target bun --external playwright --external playwright-core --outdir ./dist",
    "build:darwin-arm64": "bun scripts/build-binary.ts bun-darwin-arm64",
    "build:linux-x64": "bun scripts/build-binary.ts bun-linux-x64",
    "build:maps": "cd google-maps-scraper && go build -o maps-leads$(go env GOEXE) .",
    "test": "bun test --timeout 20000"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.0.1",
    "libphonenumber-js": "^1.13.15",
    "linkedom": "^0.18.15",
    "parse5": "^8.0.1",
    "playwright": "^1.62.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "2.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.7.3"
  }
}
