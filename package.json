{
  "name": "lookacrawler",
  "version": "1.0.0",
  "description": "Token-optimized local MCP server for web crawling and LLM content extraction",
  "main": "index.ts",
  "bin": {
    "lookacrawler": "./cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch run index.ts",
    "cli": "bun run cli.ts",
    "serve": "bun run index.ts --transport sse",
    "build": "bun build index.ts --target bun --external playwright --external playwright-core --outdir ./dist",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "turndown": "^7.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
